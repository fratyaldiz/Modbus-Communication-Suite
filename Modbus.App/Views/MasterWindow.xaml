<Window x:Class="Modbus.App.Views.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Modbus.App.ViewModels"
        Title="Modbus Communication Suite — Master / Client"
        Width="1320" Height="880" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.DataContext>
        <vm:MasterViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,2,8,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,2,8,2"/></Style>
        <Style TargetType="Label"><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#455A64"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AlternatingRowBackground" Value="#F5F7F9"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MODBUS COMMUNICATION SUITE" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="MASTER / CLIENT — Register oku ve yaz" Foreground="#BBDEFB" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="#90CAF9" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONNECTION -->
        <Border Grid.Row="1" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="Protocol" Margin="0,0,8,0"/>
                <ComboBox Width="140" SelectedIndex="{Binding ProtocolIndex}">
                    <ComboBoxItem>Modbus TCP/IP</ComboBoxItem>
                    <ComboBoxItem>Modbus RTU</ComboBoxItem>
                </ComboBox>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsTcp}">
                    <Label Content="IP" Margin="0,0,6,0"/>
                    <TextBox Width="120" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Port" Margin="0,0,6,0"/>
                    <TextBox Width="70" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsRtu}" Margin="8,0,0,0">
                    <Label Content="COM" Margin="0,0,6,0"/>
                    <ComboBox Width="80" IsEditable="True" ItemsSource="{Binding AvailablePorts}" Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="⟳" Width="26" Height="26" Margin="0,2,8,2" Command="{Binding RefreshComPortsCommand}"/>
                    <Label Content="Baud" Margin="0,0,6,0"/>
                    <ComboBox Width="76" IsEditable="True" ItemsSource="{Binding BaudRateOptions}" Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Data" Margin="0,0,6,0"/>
                    <ComboBox Width="46" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}"/>
                    <Label Content="Parity" Margin="0,0,6,0"/>
                    <ComboBox Width="66" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}"/>
                    <Label Content="Stop" Margin="0,0,6,0"/>
                    <ComboBox Width="96" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                </StackPanel>
                <Label Content="Timeout" Margin="8,0,6,0"/>
                <TextBox Width="60" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="CONNECT" Height="28" Padding="14,0" Margin="8,0,6,0" Background="#00897B" Foreground="White" BorderThickness="0" Command="{Binding ConnectCommand}"/>
                <Button Content="DISCONNECT" Height="28" Padding="12,0" Background="#C62828" Foreground="White" BorderThickness="0" Command="{Binding DisconnectCommand}"/>
            </StackPanel>
        </Border>

        <!-- REQUEST -->
        <Border Grid.Row="2" Background="#F5F7F9" BorderBrush="#CFD8DC" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="Unit" Margin="0,0,6,0"/>
                <TextBox Width="46" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Function" Margin="0,0,6,0"/>
                <ComboBox Width="200" SelectedIndex="{Binding FunctionIndex}">
                    <ComboBoxItem>01 Read Coils</ComboBoxItem>
                    <ComboBoxItem>03 Read Holding Registers</ComboBoxItem>
                    <ComboBoxItem>04 Read Input Registers</ComboBoxItem>
                    <ComboBoxItem>06 Write Single Register</ComboBoxItem>
                    <ComboBoxItem>02 Read Discrete Inputs</ComboBoxItem>
                    <ComboBoxItem>05 Write Single Coil</ComboBoxItem>
                    <ComboBoxItem>16 Write Multiple Registers</ComboBoxItem>
                </ComboBox>
                <Label Content="Address" Margin="0,0,6,0"/>
                <TextBox Width="80" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Quantity" Margin="0,0,6,0"/>
                <TextBox Width="55" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Write Value" Margin="0,0,6,0"/>
                <TextBox Width="70" Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="FC16 Values" Margin="0,0,6,0"/>
                <TextBox Width="130" Text="{Binding WriteValues, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="SEND REQUEST" Height="28" Padding="12,0" Margin="8,0,10,0" Background="#1565C0" Foreground="White" BorderThickness="0" Command="{Binding SendCommand}"/>
                <Button Content="{Binding PollButtonText}" Height="28" Padding="12,0" Margin="0,0,6,0" Background="#6A1B9A" Foreground="White" BorderThickness="0" Command="{Binding TogglePollCommand}"/>
                <Label Content="Scan(ms)" Margin="0,0,6,0"/>
                <TextBox Width="60" Text="{Binding ScanRate, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- MAIN: watch + inspector/status -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="6">
                <TabItem Header="Client Register Watch">
                    <DataGrid ItemsSource="{Binding ClientRegisters}" SelectedItem="{Binding SelectedRegister}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PLC Addr" Binding="{Binding LogicalAddress}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="Raw" Binding="{Binding RawValue}" Width="70"/>
                            <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="80"/>
                            <DataGridTextColumn Header="Display Value" Binding="{Binding DisplayValue}" Width="140"/>
                            <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="70"/>
                            <DataGridTextColumn Header="Binary" Binding="{Binding Binary}" Width="140"/>
                            <DataGridTextColumn Header="Last Update" Binding="{Binding LastUpdated}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Client Bit Watch">
                    <DataGrid ItemsSource="{Binding ClientBits}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="180"/>
                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="120"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding NumericValue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <TabControl Grid.Column="1" Margin="6">
                <TabItem Header="Data Inspector">
                    <DataGrid ItemsSource="{Binding InspectorFields}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Status / Active Events">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding StatusSummary}" FontWeight="SemiBold" Foreground="#37474F" Margin="4"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveEvents}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="50"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- TRAFFIC / LOG -->
        <TabControl Grid.Row="4" Margin="6,0,6,0">
            <TabItem Header="Communication Traffic">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="TX — Gönderilen istek">
                        <DataGrid ItemsSource="{Binding RequestBytes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Offset}" Width="40"/>
                                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="55"/>
                                <DataGridTextColumn Header="DEC" Binding="{Binding Decimal}" Width="50"/>
                                <DataGridTextColumn Header="BINARY" Binding="{Binding Binary}" Width="90"/>
                                <DataGridTextColumn Header="MEANING" Binding="{Binding Meaning}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="RX — Alınan cevap">
                        <DataGrid ItemsSource="{Binding ResponseBytes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Offset}" Width="40"/>
                                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="55"/>
                                <DataGridTextColumn Header="DEC" Binding="{Binding Decimal}" Width="50"/>
                                <DataGridTextColumn Header="BINARY" Binding="{Binding Binary}" Width="90"/>
                                <DataGridTextColumn Header="MEANING" Binding="{Binding Meaning}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Log">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="CLEAR LOG" HorizontalAlignment="Right" Height="26" Padding="10,0" Command="{Binding ClearLogCommand}" Margin="4"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="#111" Foreground="#64B5F6" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="5" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mode: MASTER / CLIENT" Foreground="#455A64"/>
                <TextBlock Text="   |   Tx: " Foreground="#455A64"/><TextBlock Text="{Binding TxCount}" Foreground="#1565C0" FontWeight="Bold"/>
                <TextBlock Text="   Rx: " Foreground="#455A64"/><TextBlock Text="{Binding RxCount}" Foreground="#2E7D32" FontWeight="Bold"/>
                <TextBlock Text="   Err: " Foreground="#455A64"/><TextBlock Text="{Binding ErrCount}" Foreground="#C62828" FontWeight="Bold"/>
                <TextBlock Text="   Timeout: " Foreground="#455A64"/><TextBlock Text="{Binding TimeoutCount}" Foreground="#EF6C00" FontWeight="Bold"/>
                <TextBlock Text="   |   " Foreground="#B0BEC5"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="#0D47A1" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
