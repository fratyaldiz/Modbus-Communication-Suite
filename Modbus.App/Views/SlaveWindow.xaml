<Window x:Class="Modbus.App.Views.SlaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Modbus.App.ViewModels"
        Title="Modbus Communication Suite — Slave / Server"
        Width="1280" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.DataContext>
        <vm:SlaveViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#455A64"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F7F9"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="270"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MODBUS COMMUNICATION SUITE" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="SLAVE / SERVER — Sanal cihaz simülatörü" Foreground="#C8E6C9" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Server: " Foreground="#A5D6A7" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerStatus}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONFIG -->
        <Border Grid.Row="1" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Device profile -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Label Content="Device Profile" Margin="0,0,8,0"/>
                    <ComboBox Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/>
                    <Button Content="LOAD PROFILE" Height="26" Padding="10,0" Margin="0,0,16,0"
                            Background="#455A64" Foreground="White" BorderThickness="0"
                            Command="{Binding LoadProfileCommand}"/>
                    <Label Content="Protocol" Margin="0,0,8,0"/>
                    <ComboBox Width="150" SelectedIndex="{Binding ProtocolIndex}">
                        <ComboBoxItem>Modbus TCP/IP</ComboBoxItem>
                        <ComboBoxItem>Modbus RTU</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Connection params -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <!-- TCP -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsTcp}">
                        <Label Content="Listen Port" Margin="0,0,6,0"/>
                        <TextBox Width="90" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <!-- RTU -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsRtu}" Margin="10,0,0,0">
                        <Label Content="COM" Margin="0,0,6,0"/>
                        <ComboBox Width="90" IsEditable="True" ItemsSource="{Binding AvailablePorts}" Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="⟳" Width="26" Height="26" Margin="0,2,8,2" Command="{Binding RefreshComPortsCommand}"/>
                        <Label Content="Baud" Margin="0,0,6,0"/>
                        <ComboBox Width="80" IsEditable="True" ItemsSource="{Binding BaudRateOptions}" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Data" Margin="0,0,6,0"/>
                        <ComboBox Width="50" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}"/>
                        <Label Content="Parity" Margin="0,0,6,0"/>
                        <ComboBox Width="70" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}"/>
                        <Label Content="Stop" Margin="0,0,6,0"/>
                        <ComboBox Width="100" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                        <Label Content="Unit ID" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Content="START SERVER" Height="28" Padding="12,0" Margin="16,0,6,0"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            Command="{Binding StartServerCommand}"/>
                    <Button Content="STOP SERVER" Height="28" Padding="12,0"
                            Background="#C62828" Foreground="White" BorderThickness="0"
                            Command="{Binding StopServerCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- REGISTER MEMORY -->
        <GroupBox Grid.Row="2" Header="Register Memory — tek doğruluk kaynağı (Master bu değerleri okur/yazar)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="AddBtn" Content="+ ADD REGISTER" Height="28" Padding="10,0" Margin="0,0,6,0"
                            Background="#1565C0" Foreground="White" BorderThickness="0" Click="OnAddRegister"/>
                    <Button x:Name="EditBtn" Content="EDIT" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Background="#00838F" Foreground="White" BorderThickness="0" Click="OnEditRegister"/>
                    <Button x:Name="DeleteBtn" Content="DELETE" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Background="#B71C1C" Foreground="White" BorderThickness="0" Click="OnDeleteRegister"/>
                    <Button Content="CLEAR CUSTOM" Height="28" Padding="12,0"
                            Background="#607D8B" Foreground="White" BorderThickness="0"
                            Command="{Binding ClearCustomCommand}"/>
                    <TextBlock Text="Raw Value hücresini çift tıklayıp değiştirebilirsin (sim değeri anında server hafızasına yazılır)."
                               Foreground="#78909C" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Memory.Registers}"
                          SelectedItem="{Binding SelectedRegister}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PLC Addr" Binding="{Binding LogicalAddress}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="PDU" Binding="{Binding PduAddress}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding RegisterTypeText}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Raw Value" Binding="{Binding RawValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Display Value" Binding="{Binding DisplayValue}" IsReadOnly="True" Width="130"/>
                        <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Access" Binding="{Binding AccessText}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" IsReadOnly="True" Width="65"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Last Update" Binding="{Binding LastUpdated}" IsReadOnly="True" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- LOWER TABS -->
        <TabControl Grid.Row="3" Margin="6,0,6,0">
            <TabItem Header="Status / Active Events">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding StatusSummary}" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center"/>
                        <CheckBox Content="Show Active Only" IsChecked="{Binding ShowActiveOnly}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveEventsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="50"/>
                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Communication Traffic">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="RX — Master'dan gelen istek">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding LastRequestSummary}" Foreground="#1565C0" Margin="3" TextWrapping="Wrap"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RequestBytes}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Offset}" Width="40"/>
                                    <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="55"/>
                                    <DataGridTextColumn Header="DEC" Binding="{Binding Decimal}" Width="50"/>
                                    <DataGridTextColumn Header="BINARY" Binding="{Binding Binary}" Width="90"/>
                                    <DataGridTextColumn Header="MEANING" Binding="{Binding Meaning}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="TX — Slave'in gönderdiği cevap">
                        <DataGrid ItemsSource="{Binding ResponseBytes}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Offset}" Width="40"/>
                                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="55"/>
                                <DataGridTextColumn Header="DEC" Binding="{Binding Decimal}" Width="50"/>
                                <DataGridTextColumn Header="BINARY" Binding="{Binding Binary}" Width="90"/>
                                <DataGridTextColumn Header="MEANING" Binding="{Binding Meaning}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Log">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="CLEAR LOG" HorizontalAlignment="Right" Height="26" Padding="10,0"
                            Command="{Binding ClearLogCommand}" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="#111" Foreground="#8BC34A"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock>
                <Run Text="Mode: SLAVE / SERVER" Foreground="#455A64"/>
                <Run Text="   |   " Foreground="#B0BEC5"/>
                <Run Text="Profile: " Foreground="#455A64"/>
                <Run Text="{Binding SelectedProfile.Name, Mode=OneWay}" Foreground="#1B5E20" FontWeight="SemiBold"/>
                <Run Text="   |   " Foreground="#B0BEC5"/>
                <Run Text="{Binding ServerStatus, Mode=OneWay}" Foreground="#2E7D32" FontWeight="SemiBold"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>
