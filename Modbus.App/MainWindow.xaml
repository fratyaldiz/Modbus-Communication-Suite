<Window x:Class="Modbus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Modbus.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Modbus Master / Slave Emulator"
        Width="1550"
        Height="950"
        MinWidth="900"
        MinHeight="600"
        WindowState="Maximized"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F4F6F8">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- Register türleri -->
        <x:Array x:Key="RegisterTypeOptions"
                 Type="{x:Type sys:String}">
            <sys:String>Holding Register</sys:String>
            <sys:String>Input Register</sys:String>
        </x:Array>

        <!-- Veri türleri -->
        <x:Array x:Key="DataTypeOptions"
                 Type="{x:Type sys:String}">
            <sys:String>UInt16</sys:String>
            <sys:String>Int16</sys:String>
            <sys:String>UInt32</sys:String>
            <sys:String>Int32</sys:String>
            <sys:String>Float32</sys:String>
            <sys:String>Double64</sys:String>
            <sys:String>String</sys:String>
        </x:Array>

        <!-- Byte sıraları -->
        <x:Array x:Key="ByteOrderOptions"
                 Type="{x:Type sys:String}">
            <sys:String>AB CD</sys:String>
            <sys:String>CD AB</sys:String>
            <sys:String>BA DC</sys:String>
            <sys:String>DC BA</sys:String>
        </x:Array>

        <Style x:Key="FormLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,7,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#B5BEC5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#B5BEC5"/>
        </Style>

        <Style x:Key="ToolbarButton"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#33434D"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E3F2FD"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#90CAF9"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BBDEFB"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="13,3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StartButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
        </Style>

        <Style x:Key="StopButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#8E0000"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B7C0C7"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#B7C0C7"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D5DADD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D5DADD"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F3F4"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#C8CFD4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Background" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background" Value="#A8D0F8"/>
                    <Setter Property="Foreground" Value="#102A43"/>
                </Trigger>

                <DataTrigger Binding="{Binding IsChanged}"
                             Value="True">
                    <Setter Property="Background" Value="#A9E89D"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="MonoCell"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="MonoValueCell"
               TargetType="TextBlock"
               BasedOn="{StaticResource MonoCell}">
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ChangedValueCell"
               TargetType="TextBlock"
               BasedOn="{StaticResource MonoCell}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsChanged}"
                             Value="True">
                    <Setter Property="Background" Value="#8EE581"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <!-- Register sağ tık menüsü -->
        <ContextMenu x:Key="RegisterContextMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.SelectedItem,
                                           RelativeSource={RelativeSource Self}}">

            <MenuItem Header="Signed — Int16"
                      Tag="Int16"
                      Click="SetDataType_Click"/>

            <MenuItem Header="Unsigned — UInt16"
                      Tag="UInt16"
                      Click="SetDataType_Click"/>

            <Separator/>

            <MenuItem Header="Long / Int32"
                      Tag="Int32"
                      Click="SetDataType_Click"/>

            <MenuItem Header="Unsigned Long / UInt32"
                      Tag="UInt32"
                      Click="SetDataType_Click"/>

            <MenuItem Header="Float — IEEE 754"
                      Tag="Float32"
                      Click="SetDataType_Click"/>

            <MenuItem Header="Double — IEEE 754"
                      Tag="Double64"
                      Click="SetDataType_Click"/>

            <MenuItem Header="String / ASCII"
                      Tag="String"
                      Click="SetDataType_Click"/>

            <Separator/>

            <MenuItem Header="Byte Order">

                <MenuItem Header="AB CD"
                          Tag="AB CD"
                          Click="SetByteOrder_Click"/>

                <MenuItem Header="CD AB"
                          Tag="CD AB"
                          Click="SetByteOrder_Click"/>

                <MenuItem Header="BA DC"
                          Tag="BA DC"
                          Click="SetByteOrder_Click"/>

                <MenuItem Header="DC BA"
                          Tag="DC BA"
                          Click="SetByteOrder_Click"/>

            </MenuItem>

            <Separator/>

            <MenuItem Header="Display Value Kopyala"
                      Click="CopyDisplayValue_Click"/>

            <MenuItem Header="Raw Value Kopyala"
                      Click="CopyRawValue_Click"/>

            <MenuItem Header="Değişim Rengini Temizle"
                      Click="ResetRowColor_Click"/>

        </ContextMenu>

    </Window.Resources>

    <!--
        RESPONSIVE TASARIM (fill-or-scroll):
        Dış ScrollViewer + iç Grid. Grid'in genişlik/yüksekliği ScrollViewer'ın
        görünür alanına (ViewportWidth/ViewportHeight) bağlıdır. Böylece:
         - Pencere yeterince büyükse: içerik ALANI DOLDURUR, star satırlar (orta ve
           alt Communication Traffic) büyür.
         - Pencere küçük veya yüksek DPI/ölçek ise: MinWidth/MinHeight devreye girer,
           kaydırma çubuğu çıkar; hiçbir şey görev çubuğu arkasında kalmaz, her şey
           erişilebilir olur.
        Eski Viewbox (sabit 1550x900'ü piksel ölçekleme) kaldırıldı — o yaklaşım oranı
        kilitliyor, alt paneli büyütmüyor ve dar ekranlarda taşırıyordu. Artık gerçek
        responsive ve kontroller doğal boyutta.
    -->
    <ScrollViewer x:Name="RootScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Background="#F4F6F8"
              MinWidth="1520"
              MinHeight="950"
              Width="{Binding ViewportWidth, ElementName=RootScroll}"
              Height="{Binding ViewportHeight, ElementName=RootScroll}">

        <Grid.RowDefinitions>
            <RowDefinition Height="27"/>
            <RowDefinition Height="73"/>
            <RowDefinition Height="Auto" MinHeight="112"/>
            <!-- Orta bölüm ve alt Communication Traffic artık ikisi de star:
                 pencere büyüdükçe ORANTILI büyürler, aradaki GridSplitter ile
                 kullanıcı payı ayarlayabilir. -->
            <RowDefinition Height="2*" MinHeight="280"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="1*" MinHeight="150"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- Menü -->
        <Menu Grid.Row="0"
              Background="#F6F6F6"
              Foreground="#202020"
              BorderBrush="#D5DADD"
              BorderThickness="0,0,0,1">

            <MenuItem Header="_File">

                <MenuItem Header="Start Server"
                          Command="{Binding StartServerCommand}"/>

                <MenuItem Header="Stop Server"
                          Command="{Binding StopServerCommand}"/>

                <Separator/>

                <MenuItem Header="Connect Client"
                          Command="{Binding ConnectClientCommand}"/>

                <MenuItem Header="Disconnect Client"
                          Command="{Binding DisconnectClientCommand}"/>

            </MenuItem>

            <MenuItem Header="_Edit">

                <MenuItem Header="Reset Colors"
                          Command="{Binding ResetColorsCommand}"/>

                <MenuItem Header="Clear Log"
                          Command="{Binding ClearLogCommand}"/>

            </MenuItem>

            <!-- Bu menüler sonraki geliştirmeler için yer tutucudur.
                 Komuta bağlı olmadıkları için yanlış beklenti oluşturmasın diye pasiftir. -->
            <MenuItem Header="_Display"
                      IsEnabled="False"/>

            <MenuItem Header="_Tools"
                      IsEnabled="False"/>

            <MenuItem Header="_Functions"
                      IsEnabled="False"/>

            <MenuItem Header="_Realtime Charting"
                      IsEnabled="False"/>

            <MenuItem Header="_Help"
                      IsEnabled="False"/>

        </Menu>

        <!-- Araç çubuğu -->
        <Border Grid.Row="1"
                Background="#FAFAFA"
                BorderBrush="#D2D8DC"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="8,4">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ConnectClientCommand}">

                        <StackPanel>
                            <TextBlock Text="🔗"
                                       FontSize="19"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Open Connection"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding DisconnectClientCommand}">

                        <StackPanel>
                            <TextBlock Text="⏻"
                                       FontSize="19"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Close Connection"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Separator Margin="5,4"/>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding StartServerCommand}">

                        <StackPanel>
                            <TextBlock Text="▶"
                                       FontSize="19"
                                       Foreground="#2E7D32"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Start Server"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding StopServerCommand}">

                        <StackPanel>
                            <TextBlock Text="■"
                                       FontSize="19"
                                       Foreground="#C62828"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Stop Server"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Separator Margin="5,4"/>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding SendCommand}">

                        <StackPanel>
                            <TextBlock Text="⇄"
                                       FontSize="20"
                                       Foreground="#1976D2"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Send Request"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ClearLogCommand}">

                        <StackPanel>
                            <TextBlock Text="≡"
                                       FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Clear Log"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ResetColorsCommand}">

                        <StackPanel>
                            <TextBlock Text="↺"
                                       FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Reset Colors"
                                       FontSize="11"/>
                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- Üst bağlantı göstergeleri -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Margin="10,2">

                        <TextBlock Text="CLIENT SOCKET"
                                   FontSize="10"
                                   Foreground="#607D8B"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,5,0">

                                <Ellipse.Style>

                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D32F2F"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ClientStatus}"
                                                         Value="Bağlandı">
                                                <Setter Property="Fill" Value="#2E7D32"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Ellipse.Style>

                            </Ellipse>

                            <TextBlock Text="{Binding ClientStatus}"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Margin="10,2">

                        <TextBlock Text="SERVER CLIENT"
                                   FontSize="10"
                                   Foreground="#607D8B"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,5,0">

                                <Ellipse.Style>

                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D32F2F"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsServerClientConnected}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="#2E7D32"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Ellipse.Style>

                            </Ellipse>

                            <TextBlock Text="{Binding ServerClientStatus}"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Margin="10,2">
                        <TextBlock Text="SERVER LISTENER"
                                   FontSize="10"
                                   Foreground="#607D8B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ServerStatus}"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Bağlantı ve istek ayarları -->
        <Border Grid.Row="2"
                Background="#EDF1F4"
                BorderBrush="#CFD6DB"
                BorderThickness="0,0,0,1"
                Padding="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"
                                      MinWidth="555"/>
                    <ColumnDefinition Width="0.50*"
                                      MinWidth="230"/>
                    <ColumnDefinition Width="1.25*"
                                      MinWidth="690"/>
                </Grid.ColumnDefinitions>

                <!-- CLIENT / MASTER -->
                <GroupBox Grid.Column="0"
                          Header="Client / Master"
                          Margin="0,0,5,0">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TCP VE PROTOKOL AYARLARI -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Protocol"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding ClientProtocolIndex}">
                                <ComboBoxItem>Modbus TCP/IP</ComboBoxItem>
                                <ComboBoxItem>Modbus RTU</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Column="2"
                                       Text="IP"
                                       Style="{StaticResource FormLabel}"/>

                            <TextBox Grid.Column="3"
                                     ToolTip="Modbus TCP server adresi. Aynı bilgisayar için 127.0.0.1 kullanılır."
                                     Text="{Binding ClientIpAddress,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="4"
                                       Text="Port"
                                       Style="{StaticResource FormLabel}"/>

                            <TextBox Grid.Column="5"
                                     ToolTip="Client'ın bağlanacağı TCP portu. Server Listen Port ile aynı olmalıdır."
                                     Text="{Binding ClientPort,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                        </Grid>

                        <!-- RTU PORT VE HIZ AYARLARI -->
                        <Grid Grid.Row="1">

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientProtocolIndex}"
                                                     Value="1">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="COM Port"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="1"
                                      IsEditable="True"
                                      ItemsSource="{Binding AvailableComPorts}"
                                      ToolTip="USB-RS485 dönüştürücünün Windows'ta görünen COM portu."
                                      Text="{Binding ClientComPort,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="2"
                                    Height="27"
                                    Margin="2"
                                    Padding="5,1"
                                    Content="Yenile"
                                    ToolTip="Bilgisayardaki COM portlarını yeniden tara."
                                    Command="{Binding RefreshComPortsCommand}"/>

                            <TextBlock Grid.Column="3"
                                       Text="Baud"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="4"
                                      IsEditable="True"
                                      ItemsSource="{Binding BaudRateOptions}"
                                      ToolTip="Kartın haberleşme hızıyla aynı olmalıdır. Örnek: 9600."
                                      Text="{Binding ClientBaudRate,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                        </Grid>

                        <!-- RTU ÇERÇEVE AYARLARI -->
                        <Grid Grid.Row="2">

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientProtocolIndex}"
                                                     Value="1">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Data"
                                       ToolTip="Data Bits"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DataBitsOptions}"
                                      SelectedItem="{Binding ClientDataBits,
                                                             Mode=TwoWay}"/>

                            <TextBlock Grid.Column="2"
                                       Text="Parity"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding ParityOptions}"
                                      SelectedItem="{Binding ClientParity,
                                                             Mode=TwoWay}"
                                      ToolTip="None=8N1, Even=8E1, Odd=8O1 örneklerinde orta harftir."/>

                            <TextBlock Grid.Column="4"
                                       Text="Stop Bits"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Column="5"
                                      ItemsSource="{Binding StopBitsOptions}"
                                      SelectedItem="{Binding ClientStopBits,
                                                             Mode=TwoWay}"
                                      ToolTip="One=1, OnePointFive=1.5, Two=2 stop bit."/>

                            <TextBlock Grid.Column="6"
                                       Text="Timeout"
                                       Style="{StaticResource FormLabel}"/>

                            <TextBox Grid.Column="7"
                                     ToolTip="Kart cevabının bekleneceği süre, milisaniye. Önerilen başlangıç: 3000."
                                     Text="{Binding ClientTimeout,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                        </Grid>

                    </Grid>

                </GroupBox>

                <!-- SERVER / SLAVE -->
                <GroupBox Grid.Column="1"
                          Header="Server / Slave"
                          Margin="0,0,5,0">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- R0: Protocol + Listen Port -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Protocol"
                                   Style="{StaticResource FormLabel}"/>

                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  ToolTip="TCP: Ethernet üzerinden sanal cihaz. RTU: seri port (kart Master ise)."
                                  SelectedIndex="{Binding ServerProtocolIndex}">
                            <ComboBoxItem>Modbus TCP/IP</ComboBoxItem>
                            <ComboBoxItem>Modbus RTU (Seri)</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Listen Port"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 ToolTip="TCP modu: Server'ın dinleyeceği port. Client Port ile aynı olmalıdır."
                                 Text="{Binding ServerPort,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- R1: RTU slave seri ayarları (yalnızca RTU modunda aktif) -->
                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="4"
                              Margin="0,4,0,0">

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerProtocolIndex}"
                                                     Value="1">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COM Port + Yenile -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="COM"
                                       Style="{StaticResource FormLabel}"/>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          IsEditable="True"
                                          ItemsSource="{Binding AvailableComPorts}"
                                          ToolTip="Kartın bağlı olduğu COM portu."
                                          Text="{Binding ServerComPort,
                                                         UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                        Height="27"
                                        Margin="2"
                                        Padding="5,1"
                                        Content="Yenile"
                                        ToolTip="COM portlarını yeniden tara."
                                        Command="{Binding RefreshComPortsCommand}"/>
                            </Grid>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Baud"
                                       Style="{StaticResource FormLabel}"/>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="3"
                                      IsEditable="True"
                                      ItemsSource="{Binding BaudRateOptions}"
                                      ToolTip="Kartın hızıyla aynı olmalıdır."
                                      Text="{Binding ServerBaudRate,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- İkinci satır: Data / Parity / Stop / Unit -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,2,0,0">

                                <TextBlock Text="Data"
                                           Style="{StaticResource FormLabel}"/>
                                <ComboBox Width="46"
                                          ItemsSource="{Binding DataBitsOptions}"
                                          SelectedItem="{Binding ServerDataBits, Mode=TwoWay}"/>

                                <TextBlock Text="Parity"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource FormLabel}"/>
                                <ComboBox Width="72"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding ServerParity, Mode=TwoWay}"/>

                                <TextBlock Text="Stop"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource FormLabel}"/>
                                <ComboBox Width="95"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding ServerStopBits, Mode=TwoWay}"/>

                                <TextBlock Text="Unit"
                                           Margin="8,0,0,0"
                                           ToolTip="Bu sanal cihazın adresi. Master bu adrese soru sorar."
                                           Style="{StaticResource FormLabel}"/>
                                <TextBox Width="46"
                                         Text="{Binding ServerUnitId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- R2: START / STOP -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0">

                            <Button Content="START"
                                    Style="{StaticResource StartButton}"
                                    Command="{Binding StartServerCommand}"/>

                            <Button Content="STOP"
                                    Style="{StaticResource StopButton}"
                                    Command="{Binding StopServerCommand}"/>

                        </StackPanel>

                        <!-- R3: RTU açıklaması -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#8A8A8A"
                                   Text="RTU modu: kart bir Master ise bu uygulama slave olur ve COM portundan gelen istekleri cevaplar. Aynı COM portu Client ile aynı anda kullanılamaz."/>

                    </Grid>

                </GroupBox>

                <!-- MODBUS REQUEST -->
                <GroupBox Grid.Column="2"
                          Header="Modbus Request">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Birinci satır: hedef ve fonksiyon -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Unit"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 ToolTip="Modbus cihaz adresi. Bu sanal server testi için 1 kullanın."
                                 Text="{Binding SlaveId,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Function"
                                   Style="{StaticResource FormLabel}"/>

                        <!-- İlk dört indeks geriye uyumluluk için korunur:
                             0=FC01, 1=FC03, 2=FC04, 3=FC06,
                             4=FC02, 5=FC05, 6=FC16 -->
                        <ComboBox Grid.Row="0"
                                  Grid.Column="3"
                                  SelectedIndex="{Binding FunctionIndex}">
                            <ComboBoxItem>01 Read Coils</ComboBoxItem>
                            <ComboBoxItem>03 Read Holding Registers</ComboBoxItem>
                            <ComboBoxItem>04 Read Input Registers</ComboBoxItem>
                            <ComboBoxItem>06 Write Single Register</ComboBoxItem>
                            <ComboBoxItem>02 Read Discrete Inputs</ComboBoxItem>
                            <ComboBoxItem>05 Write Single Coil</ComboBoxItem>
                            <ComboBoxItem>16 Write Multiple Registers</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Text="Address"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="5"
                                 ToolTip="Okuma veya yazma işleminin başlayacağı Modbus adresi."
                                 Text="{Binding Address,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- İkinci satır: okuma ve yazma parametreleri -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Quantity"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 ToolTip="FC01, FC02, FC03 ve FC04 için okunacak eleman sayısı.">

                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="0">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="1">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="2">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="4">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>

                            <TextBox.Text>
                                <Binding Path="Quantity"
                                         UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>

                        </TextBox>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="Write Value"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 ToolTip="FC06 için 0-65535; FC05 için 1/0, ON/OFF veya TRUE/FALSE girin.">

                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="3">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="5">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>

                            <TextBox.Text>
                                <Binding Path="WriteValue"
                                         UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>

                        </TextBox>

                        <Button Grid.Row="1"
                                Grid.Column="4"
                                Grid.ColumnSpan="3"
                                Content="SEND REQUEST"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendCommand}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="FC16 Values"
                                   Style="{StaticResource FormLabel}"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="5"
                                 ToolTip="FC16 için değerleri virgül, noktalı virgül veya boşlukla ayırın. Örnek: 100, 200, 300">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FunctionIndex}" Value="6">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Text>
                                <Binding Path="WriteValues"
                                         UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="7"
                                   Margin="5,3,0,0"
                                   Foreground="#607D8B"
                                   FontSize="11"
                                   Text="Okuma: Quantity. FC05/FC06: Write Value. FC16: FC16 Values listesi kullanılır."/>

                    </Grid>

                </GroupBox>

            </Grid>

        </Border>

        <!-- Ana çalışma alanı -->
        <Grid Grid.Row="3"
              Margin="7"
              MinHeight="375">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="245"
                                  MinWidth="180"
                                  MaxWidth="450"/>

                <ColumnDefinition Width="7"/>

                <ColumnDefinition Width="*"
                                  MinWidth="700"/>

            </Grid.ColumnDefinitions>

            <!-- Sol bağlantı ağacı -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#B7C0C7"
                    BorderThickness="1">

                <DockPanel>

                    <Border DockPanel.Dock="Top"
                            Background="#F1F3F4"
                            BorderBrush="#C8CFD4"
                            BorderThickness="0,0,0,1"
                            Padding="7">

                        <TextBlock Text="Connections"
                                   FontWeight="Bold"
                                   Foreground="#263238"/>

                    </Border>

                    <TreeView Background="White"
                              BorderThickness="0"
                              Padding="4">

                        <TreeViewItem Header="Local Modbus TCP Server"
                                      IsExpanded="True">

                            <TreeViewItem Header="{Binding ServerStatus}"
                                          IsExpanded="True">

                                <TreeViewItem Header="{Binding ServerClientStatus}"/>

                                <TreeViewItem Header="Unit ID 1"
                                              IsExpanded="True">

                                    <TreeViewItem Header="Holding Registers"
                                                  IsSelected="True"/>

                                    <TreeViewItem Header="Input Registers"/>

                                    <TreeViewItem Header="Coils"/>

                                </TreeViewItem>

                            </TreeViewItem>

                        </TreeViewItem>

                        <TreeViewItem Header="Modbus Client"
                                      IsExpanded="True">

                            <TreeViewItem IsExpanded="True">

                                <TreeViewItem.Header>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClientIpAddress}"/>
                                        <TextBlock Text=":"/>
                                        <TextBlock Text="{Binding ClientPort}"/>
                                    </StackPanel>

                                </TreeViewItem.Header>

                                <TreeViewItem Header="{Binding ClientStatus}"/>
                                <TreeViewItem Header="Register Watch"/>
                                <TreeViewItem Header="Bit Watch"/>
                                <TreeViewItem Header="Communication Traffic"/>

                            </TreeViewItem>

                        </TreeViewItem>

                    </TreeView>

                </DockPanel>

            </Border>

            <!-- Sol-sağ GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#B0BEC5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Cursor="SizeWE"/>

            <!-- Sağ çalışma alanı -->
            <Grid Grid.Column="2"
                  MinHeight="375">

                <Grid.RowDefinitions>

                    <RowDefinition Height="3*"
                                   MinHeight="210"/>

                    <RowDefinition Height="7"/>

                    <RowDefinition Height="2*"
                                   MinHeight="150"/>

                </Grid.RowDefinitions>

                <!-- Register tabloları -->
                <TabControl Grid.Row="0"
                            Background="White"
                            BorderBrush="#B7C0C7"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">

                    <TabItem Header="Local Server — Register Memory">

                        <Grid Background="White">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="37"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       Background="#FAFAFA"
                                       LastChildFill="False">

                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="5">

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="03"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="04"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="06"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="16"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="5,0">

                                    <Button Content="Reset Colors"
                                            Command="{Binding ResetColorsCommand}"
                                            Padding="12,3"
                                            Margin="3"/>

                                    <Button Content="Clear Log"
                                            Command="{Binding ClearLogCommand}"
                                            Padding="12,3"
                                            Margin="3"/>

                                </StackPanel>

                            </DockPanel>

                            <DataGrid x:Name="ServerRegisterGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ServerRegisters}"
                                      SelectedItem="{Binding SelectedServerRegister,
                                                             Mode=TwoWay}"
                                      IsReadOnly="False"
                                      FrozenColumnCount="4"
                                      ContextMenu="{StaticResource RegisterContextMenu}"
                                      PreviewMouseRightButtonDown="RegisterGrid_PreviewMouseRightButtonDown"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header=""
                                                        Binding="{Binding ChangeArrow}"
                                                        IsReadOnly="True"
                                                        Width="28"
                                                        ElementStyle="{StaticResource ChangedValueCell}"/>

                                    <DataGridComboBoxColumn Header="REGISTER TYPE"
                                                            ItemsSource="{StaticResource RegisterTypeOptions}"
                                                            SelectedItemBinding="{Binding RegisterType,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                            Width="135"/>

                                    <DataGridTextColumn Header="ADDRESS"
                                                        Binding="{Binding AddressHex}"
                                                        IsReadOnly="True"
                                                        Width="85"
                                                        ElementStyle="{StaticResource MonoCell}"/>

                                    <DataGridTextColumn Header="ALIAS"
                                                        Binding="{Binding Alias,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                        Width="155"/>

                                    <!-- Ham 16 bit değer -->
                                    <DataGridTextColumn Header="UNSIGNED"
                                                        Binding="{Binding Value,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                        Width="85"
                                                        ElementStyle="{StaticResource ChangedValueCell}"/>

                                    <DataGridTextColumn Header="SIGNED"
                                                        Binding="{Binding SignedValue}"
                                                        IsReadOnly="True"
                                                        Width="80"
                                                        ElementStyle="{StaticResource MonoCell}"/>

                                    <DataGridTextColumn Header="HEX"
                                                        Binding="{Binding HexValue}"
                                                        IsReadOnly="True"
                                                        Width="90"
                                                        ElementStyle="{StaticResource MonoCell}"/>

                                    <DataGridTextColumn Header="BINARY"
                                                        Binding="{Binding BinaryValue}"
                                                        IsReadOnly="True"
                                                        Width="165"
                                                        ElementStyle="{StaticResource MonoCell}"/>

                                    <DataGridComboBoxColumn Header="DATA TYPE"
                                                            ItemsSource="{StaticResource DataTypeOptions}"
                                                            SelectedItemBinding="{Binding DataType,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                            Width="105"/>

                                    <DataGridComboBoxColumn Header="BYTE ORDER"
                                                            ItemsSource="{StaticResource ByteOrderOptions}"
                                                            SelectedItemBinding="{Binding ByteOrder,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                            Width="100"/>

                                    <DataGridTextColumn Header="DISPLAY VALUE"
                                                        Binding="{Binding DisplayValue}"
                                                        IsReadOnly="True"
                                                        Width="145"
                                                        ElementStyle="{StaticResource MonoCell}"/>

                                    <DataGridTextColumn Header="COMMENT"
                                                        Binding="{Binding Comment,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                        Width="220"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </TabItem>

                    <TabItem Header="Local Server — Bit Memory">

                        <Grid Background="White">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="37"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       Background="#FAFAFA"
                                       LastChildFill="False">

                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="5">

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="01"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="02"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#5CB85C"
                                            CornerRadius="3"
                                            Padding="9,3"
                                            Margin="2">
                                        <TextBlock Text="05"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Text="Coil ve Discrete Input durumlarını değiştirerek cihaz davranışını taklit edin."
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="#607D8B"/>

                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="Reset Colors"
                                        Command="{Binding ResetColorsCommand}"
                                        Padding="12,3"
                                        Margin="5"/>

                            </DockPanel>

                            <TabControl Grid.Row="1"
                                        Background="White"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">

                                <TabItem Header="Coils — FC01 oku / FC05 yaz">
                                    <DataGrid ItemsSource="{Binding ServerCoils}"
                                              IsReadOnly="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header=""
                                                                Binding="{Binding ChangeArrow}"
                                                                IsReadOnly="True"
                                                                Width="28"
                                                                ElementStyle="{StaticResource ChangedValueCell}"/>
                                            <DataGridTextColumn Header="BIT TYPE"
                                                                Binding="{Binding BitType}"
                                                                IsReadOnly="True"
                                                                Width="130"/>
                                            <DataGridTextColumn Header="ADDRESS"
                                                                Binding="{Binding AddressHex}"
                                                                IsReadOnly="True"
                                                                Width="85"
                                                                ElementStyle="{StaticResource MonoCell}"/>
                                            <DataGridTextColumn Header="ALIAS"
                                                                Binding="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="170"/>
                                            <DataGridCheckBoxColumn Header="STATE"
                                                                    Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="70"/>
                                            <DataGridTextColumn Header="VALUE"
                                                                Binding="{Binding NumericValue}"
                                                                IsReadOnly="True"
                                                                Width="65"/>
                                            <DataGridTextColumn Header="STATUS"
                                                                Binding="{Binding StateText}"
                                                                IsReadOnly="True"
                                                                Width="115"/>
                                            <DataGridTextColumn Header="UPDATED"
                                                                Binding="{Binding LastUpdated}"
                                                                IsReadOnly="True"
                                                                Width="105"
                                                                ElementStyle="{StaticResource MonoCell}"/>
                                            <DataGridTextColumn Header="COMMENT"
                                                                Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem Header="Discrete Inputs — FC02 oku">
                                    <DataGrid ItemsSource="{Binding ServerDiscreteInputs}"
                                              IsReadOnly="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header=""
                                                                Binding="{Binding ChangeArrow}"
                                                                IsReadOnly="True"
                                                                Width="28"
                                                                ElementStyle="{StaticResource ChangedValueCell}"/>
                                            <DataGridTextColumn Header="BIT TYPE"
                                                                Binding="{Binding BitType}"
                                                                IsReadOnly="True"
                                                                Width="130"/>
                                            <DataGridTextColumn Header="ADDRESS"
                                                                Binding="{Binding AddressHex}"
                                                                IsReadOnly="True"
                                                                Width="85"
                                                                ElementStyle="{StaticResource MonoCell}"/>
                                            <DataGridTextColumn Header="ALIAS"
                                                                Binding="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="170"/>
                                            <DataGridCheckBoxColumn Header="STATE"
                                                                    Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="70"/>
                                            <DataGridTextColumn Header="VALUE"
                                                                Binding="{Binding NumericValue}"
                                                                IsReadOnly="True"
                                                                Width="65"/>
                                            <DataGridTextColumn Header="STATUS"
                                                                Binding="{Binding StateText}"
                                                                IsReadOnly="True"
                                                                Width="115"/>
                                            <DataGridTextColumn Header="UPDATED"
                                                                Binding="{Binding LastUpdated}"
                                                                IsReadOnly="True"
                                                                Width="105"
                                                                ElementStyle="{StaticResource MonoCell}"/>
                                            <DataGridTextColumn Header="COMMENT"
                                                                Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>



                </TabControl>

                        </Grid>

                    </TabItem>

                    <TabItem Header="Client — Register Watch">

                        <DataGrid x:Name="ClientRegisterGrid"
                                  ItemsSource="{Binding ClientRegisters}"
                                  SelectedItem="{Binding SelectedClientRegister,
                                                         Mode=TwoWay}"
                                  IsReadOnly="True"
                                  FrozenColumnCount="4"
                                  ContextMenu="{StaticResource RegisterContextMenu}"
                                  PreviewMouseRightButtonDown="RegisterGrid_PreviewMouseRightButtonDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header=""
                                                    Binding="{Binding ChangeArrow}"
                                                    Width="28"
                                                    ElementStyle="{StaticResource ChangedValueCell}"/>

                                <DataGridTextColumn Header="REGISTER TYPE"
                                                    Binding="{Binding RegisterType}"
                                                    Width="135"/>

                                <DataGridTextColumn Header="ADDRESS"
                                                    Binding="{Binding AddressHex}"
                                                    Width="85"
                                                    ElementStyle="{StaticResource MonoCell}"/>

                                <DataGridTextColumn Header="ALIAS"
                                                    Binding="{Binding Alias}"
                                                    Width="155"/>

                                <DataGridTextColumn Header="UNSIGNED"
                                                    Binding="{Binding Value}"
                                                    Width="85"
                                                    ElementStyle="{StaticResource ChangedValueCell}"/>

                                <DataGridTextColumn Header="SIGNED"
                                                    Binding="{Binding SignedValue}"
                                                    Width="80"
                                                    ElementStyle="{StaticResource MonoCell}"/>

                                <DataGridTextColumn Header="HEX"
                                                    Binding="{Binding HexValue}"
                                                    Width="90"
                                                    ElementStyle="{StaticResource MonoCell}"/>

                                <DataGridTextColumn Header="BINARY"
                                                    Binding="{Binding BinaryValue}"
                                                    Width="165"
                                                    ElementStyle="{StaticResource MonoCell}"/>

                                <DataGridTextColumn Header="DATA TYPE"
                                                    Binding="{Binding DataType}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="BYTE ORDER"
                                                    Binding="{Binding ByteOrder}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="DISPLAY VALUE"
                                                    Binding="{Binding DisplayValue}"
                                                    Width="145"
                                                    ElementStyle="{StaticResource MonoCell}"/>

                                <DataGridTextColumn Header="COMMENT"
                                                    Binding="{Binding Comment}"
                                                    Width="220"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </TabItem>

                    <TabItem Header="Client — Bit Watch">

                        <Grid Background="White">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#FAFAFA"
                                    BorderBrush="#D5DADD"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <TextBlock Text="FC01 ve FC02 okuma sonuçları ile FC05 yazma onayı burada gösterilir."
                                           Foreground="#455A64"/>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ClientBits}"
                                      IsReadOnly="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header=""
                                                        Binding="{Binding ChangeArrow}"
                                                        Width="28"
                                                        ElementStyle="{StaticResource ChangedValueCell}"/>
                                    <DataGridTextColumn Header="BIT TYPE"
                                                        Binding="{Binding BitType}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="ADDRESS"
                                                        Binding="{Binding AddressHex}"
                                                        Width="90"
                                                        ElementStyle="{StaticResource MonoCell}"/>
                                    <DataGridTextColumn Header="ALIAS"
                                                        Binding="{Binding Alias}"
                                                        Width="180"/>
                                    <DataGridCheckBoxColumn Header="STATE"
                                                            Binding="{Binding State}"
                                                            Width="75"/>
                                    <DataGridTextColumn Header="VALUE"
                                                        Binding="{Binding NumericValue}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="STATUS"
                                                        Binding="{Binding StateText}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="UPDATED"
                                                        Binding="{Binding LastUpdated}"
                                                        Width="110"
                                                        ElementStyle="{StaticResource MonoCell}"/>
                                    <DataGridTextColumn Header="COMMENT"
                                                        Binding="{Binding Comment}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>

                    </TabItem>



                </TabControl>

                <!-- Yukarı-aşağı GridSplitter -->
                <GridSplitter Grid.Row="1"
                              Height="7"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#B0BEC5"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Cursor="SizeNS"/>

                <!-- Data Inspector -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#B7C0C7"
                        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F8F9FA"
                                BorderBrush="#D4DADD"
                                BorderThickness="0,0,0,1"
                                Padding="8,5">

                            <TextBlock Text="{Binding InspectorHeader}"
                                       Foreground="#1565C0"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                        </Border>

                        <TabControl Grid.Row="1"
                                    Background="White"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">

                            <TabItem Header="Unsigned-Signed-Hex-Binary">

                                <DataGrid ItemsSource="{Binding InspectorBasic}"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Alan"
                                                            Binding="{Binding Field}"
                                                            Width="190"/>

                                        <DataGridTextColumn Header="Değer"
                                                            Binding="{Binding Value}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource MonoValueCell}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Header="Long">

                                <DataGrid ItemsSource="{Binding InspectorLong}"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Byte Order"
                                                            Binding="{Binding Field}"
                                                            Width="190"/>

                                        <DataGridTextColumn Header="Int32 Value"
                                                            Binding="{Binding Value}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource MonoValueCell}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Header="Float">

                                <DataGrid ItemsSource="{Binding InspectorFloat}"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Byte Order"
                                                            Binding="{Binding Field}"
                                                            Width="190"/>

                                        <DataGridTextColumn Header="IEEE 754 Float32"
                                                            Binding="{Binding Value}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource MonoValueCell}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Header="Double">

                                <DataGrid ItemsSource="{Binding InspectorDouble}"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Byte Order"
                                                            Binding="{Binding Field}"
                                                            Width="210"/>

                                        <DataGridTextColumn Header="IEEE 754 Double64"
                                                            Binding="{Binding Value}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource MonoValueCell}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Header="String">

                                <DataGrid ItemsSource="{Binding InspectorString}"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Format"
                                                            Binding="{Binding Field}"
                                                            Width="170"/>

                                        <DataGridTextColumn Header="Text"
                                                            Binding="{Binding Value}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource MonoValueCell}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Header="IEEE 754 Analysis">

                                <Grid Margin="5">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="3">

                                        <TextBlock Text="Byte Order:"
                                                   Style="{StaticResource FormLabel}"/>

                                        <ComboBox Width="100"
                                                  SelectedIndex="{Binding InspectorByteOrderIndex}">
                                            <ComboBoxItem>AB CD</ComboBoxItem>
                                            <ComboBoxItem>CD AB</ComboBoxItem>
                                            <ComboBoxItem>BA DC</ComboBoxItem>
                                            <ComboBoxItem>DC BA</ComboBoxItem>
                                        </ComboBox>

                                    </StackPanel>

                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding Ieee754Details}"
                                              IsReadOnly="True">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn Header="Alan"
                                                                Binding="{Binding Field}"
                                                                Width="180"/>

                                            <DataGridTextColumn Header="Değer"
                                                                Binding="{Binding Value}"
                                                                Width="310"
                                                                ElementStyle="{StaticResource MonoValueCell}"/>

                                            <DataGridTextColumn Header="Açıklama"
                                                                Binding="{Binding Description}"
                                                                Width="*"/>

                                        </DataGrid.Columns>

                                    </DataGrid>

                                </Grid>

                            </TabItem>

                        </TabControl>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <!-- Ana alan ile trafik arasındaki GridSplitter -->
        <GridSplitter Grid.Row="4"
                      Height="7"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#B0BEC5"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Cursor="SizeNS"/>

        <!-- Haberleşme trafiği -->
        <GroupBox Grid.Row="5"
                  Header="Communication Traffic — Arka Planda Ne Oluyor?"
                  Margin="7,0,7,5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Margin="2,0,2,3"
                        Padding="6,3"
                        Background="#F7F9FA"
                        BorderBrush="#D5DADD"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="2,0,8,0"
                                   Text="{Binding LastRequestSummary, StringFormat=Son istek: {0}}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LastRequestSummary}"/>

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,2,0"
                                   Text="{Binding LastResponseSummary, StringFormat=Son cevap: {0}}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LastResponseSummary}"/>
                    </Grid>

                </Border>

                <GroupBox Grid.Row="1"
                          Grid.Column="0"
                          Header="Gönderilen İstek — TX"
                          Margin="2">

                    <DataGrid ItemsSource="{Binding RequestBytes}"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Offset}"
                                                Width="40"/>

                            <DataGridTextColumn Header="HEX"
                                                Binding="{Binding Hex}"
                                                Width="55"
                                                ElementStyle="{StaticResource MonoCell}"/>

                            <DataGridTextColumn Header="DEC"
                                                Binding="{Binding Decimal}"
                                                Width="55"/>

                            <DataGridTextColumn Header="BINARY"
                                                Binding="{Binding Binary}"
                                                Width="90"
                                                ElementStyle="{StaticResource MonoCell}"/>

                            <DataGridTextColumn Header="MEANING"
                                                Binding="{Binding Meaning}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <GroupBox Grid.Row="1"
                          Grid.Column="1"
                          Header="Alınan Cevap — RX"
                          Margin="2">

                    <DataGrid ItemsSource="{Binding ResponseBytes}"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Offset}"
                                                Width="40"/>

                            <DataGridTextColumn Header="HEX"
                                                Binding="{Binding Hex}"
                                                Width="55"
                                                ElementStyle="{StaticResource MonoCell}"/>

                            <DataGridTextColumn Header="DEC"
                                                Binding="{Binding Decimal}"
                                                Width="55"/>

                            <DataGridTextColumn Header="BINARY"
                                                Binding="{Binding Binary}"
                                                Width="90"
                                                ElementStyle="{StaticResource MonoCell}"/>

                            <DataGridTextColumn Header="MEANING"
                                                Binding="{Binding Meaning}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <GroupBox Grid.Row="1"
                          Grid.Column="2"
                          Header="Raw TX / RX Log"
                          Margin="2">

                    <DockPanel>

                        <Button DockPanel.Dock="Top"
                                Content="CLEAR LOG"
                                HorizontalAlignment="Right"
                                Padding="10,2"
                                Margin="3"
                                Command="{Binding ClearLogCommand}"/>

                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="#101417"
                                 Foreground="#8FF58B"
                                 BorderBrush="#37474F"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    </DockPanel>

                </GroupBox>

            </Grid>

        </GroupBox>

        <!-- Durum çubuğu -->
        <Border Grid.Row="6"
                Background="#F0F2F3"
                BorderBrush="#CDD4D9"
                BorderThickness="0,1,0,0">

            <DockPanel Margin="8,0">

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding InspectorHeader}"
                           Foreground="#455A64"
                           VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse Width="11"
                             Height="11"
                             Margin="0,0,5,0">

                        <Ellipse.Style>

                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D32F2F"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding ClientStatus}"
                                                 Value="Bağlandı">
                                        <Setter Property="Fill" Value="#2E7D32"/>
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Ellipse.Style>

                    </Ellipse>

                    <TextBlock Text="Client Socket: "
                               Foreground="#607D8B"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding ClientStatus}"
                               Foreground="#1976D2"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>

                    <Ellipse Width="11"
                             Height="11"
                             Margin="0,0,5,0">

                        <Ellipse.Style>

                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D32F2F"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsServerClientConnected}"
                                                 Value="True">
                                        <Setter Property="Fill" Value="#2E7D32"/>
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Ellipse.Style>

                    </Ellipse>

                    <TextBlock Text="Server Client: "
                               Foreground="#607D8B"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding ServerClientStatus}"
                               Foreground="#2E7D32"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>

                    <TextBlock Text="Listener: "
                               Foreground="#607D8B"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding ServerStatus}"
                               Foreground="#2E7D32"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </DockPanel>

        </Border>

        </Grid>

    </ScrollViewer>

</Window>